<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="kpi_dashboard.Dashboard" owl="1">
        <!-- Header -->
        <div class="kpi-dashboard-header text-white p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="fw-bold mb-1">Kpi Dashboard</h1>
                    <p class="mb-0 opacity-75">Ejemplo de herencia de componentes Owl - 3 variantes, una base</p>
                </div>
            </div>
        </div>
        <div class="mx-4 my-3">
            <!-- Loading -->
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-2x text-primary" />
                <p class="mt-3">Cargando datos...</p>
            </div>
            <!-- Section -->
            <!-- Sección 1: Tarjetas simples (KpiCard base) -->
            <h5 class="text-muted text-uppercase small fw-bold mb-3">
                <i class="fa fa-th-large me-2" />
                Tarjetas Simples — KpiCard (componente base)
            </h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-3">
                    <div t-on-click="openContacts" class="kpi-card--clickable">
                        <KpiCard
                            title="'Total Contactos'"
                            value="state.contactCount"
                            icon="'fa-users'"
                            color="'primary'" />
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div t-on-click="openUsers" class="kpi-card--clickable">
                        <KpiCard
                            title="'Usuarios Activos'"
                            value="state.userCount"
                            icon="'fa-user-circle'"
                            color="'success'" />
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiCard
                        title="'Compañías'"
                        value="state.companyCount"
                        icon="'fa-building'"
                        color="'warning'" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiCard
                        title="'Ingresos Estimados'"
                        value="54300"
                        icon="'fa-dollar'"
                        color="'info'"
                        prefix="'$'" />
                </div>
            </div>
            <!-- Sección 2: Tarjetas con tendencia (KpiTrendCard extends KpiCard) -->
            <h5 class="text-muted text-uppercase small fw-bold mb-3">
                <i class="fa fa-line-chart me-2" />
                Tarjetas con Tendencia — KpiTrendCard (hereda de KpiCard)
            </h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-3">
                    <KpiTrendCard
                        title="'Contactos'"
                        value="state.contactCount"
                        previousValue="state.previousContacts"
                        trendPeriod="'vs últimos 30 días'"
                        icon="'fa-address-book'"
                        color="'primary'" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiTrendCard
                        title="'Usuarios'"
                        value="state.userCount"
                        previousValue="state.previousUsers"
                        trendPeriod="'vs mes anterior'"
                        icon="'fa-user-plus'"
                        color="'success'" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiTrendCard
                        title="'Ventas'"
                        value="54300"
                        previousValue="48200"
                        trendPeriod="'vs mes anterior'"
                        icon="'fa-shopping-cart'"
                        color="'info'"
                        prefix="'$'" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiTrendCard
                        title="'Tickets Soporte'"
                        value="23"
                        previousValue="31"
                        trendPeriod="'vs semana anterior'"
                        icon="'fa-support'"
                        color="'danger'" />
                </div>
            </div>
            <!-- Sección 3: Tarjetas de progreso (KpiProgressCard extends KpiCard) -->
            <h5 class="text-muted text-uppercase small fw-bold mb-3">
                <i class="fa fa-tasks me-2" />
                Tarjetas de Progreso — KpiProgressCard (hereda de KpiCard)
            </h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-3">
                    <KpiProgressCard
                        title="'Meta Contactos'"
                        value="state.contactCount"
                        target="state.contactTarget"
                        icon="'fa-bullseye'"
                        color="'primary'" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiProgressCard
                        title="'Meta Usuarios'"
                        value="state.userCount"
                        target="state.userTarget"
                        icon="'fa-flag-checkered'"
                        color="'success'" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiProgressCard
                        title="'Ventas Mensuales'"
                        value="54300"
                        target="75000"
                        icon="'fa-trophy'"
                        color="'warning'"
                        prefix="'$'" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <KpiProgressCard
                        title="'Satisfacción'"
                        value="87"
                        target="100"
                        icon="'fa-smile-o'"
                        color="'info'"
                        suffix="'%'" />
                </div>
            </div>
            <!-- Info Edu -->
            <div class="card border-0 shadow-sm mt-2">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="fa fa-graduation-cap me-2 text-primary" />
                        ¿Cómo funciona la herencia?
                    </h6>
                    <div class="row">
                        <div class="col-md-4">
                            <code class="d-block mb-1">KpiCard</code>
                            <small class="text-muted">Componente BASE — define formattedValue, displayValue,
                                        cardColor, cardIcon. Template simple con valor e ícono.</small>
                        </div>
                        <div class="col-md-4">
                            <code class="d-block mb-1">KpiTrendCard extends KpiCard</code>
                            <small class="text-muted">HEREDA todo de KpiCard + agrega trendPercent, trendDirection,
                                        trendIcon. Template con indicador de tendencia.</small>
                        </div>
                        <div class="col-md-4">
                            <code class="d-block mb-1">KpiProgressCard extends KpiCard</code>
                            <small class="text-muted">HEREDA todo de KpiCard + agrega progressPercent, statusLabel.
                                        Template con barra de progreso.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
